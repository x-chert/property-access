{
	"name": "xchert/property-access",
	"description": "A flexible PHP library for accessing and manipulating nested data structures (arrays and objects) using a unified path-based interface",
	"type": "library",
	"keywords": [
		"property-access",
		"nested-data",
		"array-access",
		"object-access",
		"path",
		"accessor",
		"manipulation",
		"deep-access",
		"data-structure"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Dustin Simon"
		}
	],
	"support": {
		"issues": "https://github.com/x-chert/property-access/issues",
		"source": "https://github.com/x-chert/property-access"
	},
	"autoload": {
		"psr-4": {
			"Xchert\\PropertyAccess\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xchert\\PropertyAccess\\Test\\": "tests/"
		}
	},
	"require": {
		"php": "^8.4",
		"xchert/util": "^1.2.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.3"
	},
	"archive": {
		"exclude": [
			"/.github"
		]
	}
}
